{
  "name": "materialpbx",
  "version": "0.1.0",
  "private": true,
  "description": "A guided, visual control surface for FreePBX and Asterisk.",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "assets": "node scripts/generate-icons.mjs && node scripts/generate-social-preview.mjs",
    "build": "pnpm build:web && pnpm build:site:ci && pnpm build:desktop",
    "build:web": "pnpm --filter @materialpbx/web build",
    "build:site": "pnpm --filter @materialpbx/site build:verified",
    "build:site:ci": "pnpm --filter @materialpbx/site build",
    "check:site": "node scripts/check-site-contract.mjs",
    "check:site:pages": "node scripts/check-site-contract.mjs /MaterialPBX/ https://ding-ding-projects.github.io/MaterialPBX/",
    "check:site:managed": "node scripts/check-site-contract.mjs / https://materialpbx.yeredow264.chatgpt.site/",
    "check:runtime-mounts": "node scripts/check-runtime-mount-contract.mjs",
    "check:installer": "node scripts/check-installer-contract.mjs",
    "check:release-evidence": "node scripts/check-release-evidence-contract.mjs",
    "count:lines": "node scripts/count-lines.mjs",
    "build:desktop": "pnpm --filter materialpbx-desktop build",
    "package:windows": "pnpm --filter materialpbx-desktop package:windows",
    "dev": "pnpm --filter @materialpbx/web dev"
  },
  "devDependencies": {
    "png-to-ico": "3.0.1",
    "sharp": "0.34.4",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "electron",
      "electron-winstaller",
      "esbuild",
      "sharp"
    ]
  }
}
