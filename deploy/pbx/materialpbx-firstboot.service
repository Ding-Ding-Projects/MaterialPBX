[Unit]
Description=Install and initialize FreePBX 17 on first boot
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/materialpbx/freepbx-installed

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/materialpbx-firstboot.sh
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
